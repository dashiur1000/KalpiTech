# Copy to .env and replace both passwords. Development environment only.
# Passwords: use at least 24 letters/digits; no quotes or spaces.
MYSQL_PASSWORD=replace_with_application_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
MYSQL_PORT=3307
# Docker application port on this computer (loopback only).
APP_PORT=5080

# Manager login identifier. Used for initial account creation only.
ADMIN_EMAIL=vahadathabchirot@gmail.com
# Used only when AdminAccount is empty; changing this does not reset an existing account.
ADMIN_INITIAL_PASSWORD=replace_with_initial_manager_password

# Brevo confirmation email: enable only after verifying the sender and setting a private API key.
MAIL_ENABLED=false
MAIL_SENDER_EMAIL=vahadathabchirot@gmail.com
MAIL_SENDER_NAME=ועדת הבחירות
MAIL_API_KEY=
